{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "letreiro",
  "compatibility_date": "2026-09-10",
  "main": "./worker.js",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "letreiro.marcuscamargo-portfolio.com.br",
      "custom_domain": true
    }
  ]
}
